#!/bin/sh
# Fleet CLI entry point — runs TypeScript source via Node's type-stripping flag.
# No compile step; no runtime dependencies.
#
# readlink -f is required, not cosmetic: npm links this file into
# node_modules/.bin, so $0 is the symlink and dirname "$0" would resolve
# src/main.ts against the consumer's node_modules rather than the package.
root=$(CDPATH= cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd) || exit 2
exec node --experimental-strip-types "$root/src/main.ts" "$@"
